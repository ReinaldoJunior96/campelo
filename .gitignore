# Dependências. Instaladas pelo Docker a partir do package-lock, nunca
# versionadas: eram 103 MB e 3.597 arquivos em todo clone.
node_modules/

# Saída de build. Gerada pelo Vite dentro do container.
dist/

# Estado de execução: banco SQLite e uploads do painel.
# Em produção isto vive no volume campelo-dados, não no repositório.
dados/
*.db
*.db-wal
*.db-shm

# Backups gerados pelo `make backup`.
backups/

# Segredos. Só o .env.example fica versionado.
.env
.env.*
!.env.example

# Cópia idêntica de public/assets. Só public/ é servida pelo Vite, então
# a da raiz era 12 MB duplicados. Os arquivos continuam no disco de quem
# já clonou, apenas deixam de ser rastreados.
/assets/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache de ferramentas
.vite/
.cache/
*.tsbuildinfo

# Editor e sistema operacional
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.local
.DS_Store
Thumbs.db
