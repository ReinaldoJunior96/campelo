# Copie para .env e preencha. O .env nunca entra no git.
#
#   cp .env.example .env
#
# Gere o segredo com:
#   openssl rand -hex 32


# ============================================================
# Obrigatório
# ============================================================

# Sem ele o servidor se recusa a subir em produção. Quem tiver este valor
# assina o próprio cookie de sessão e entra no painel sem senha: trate como
# senha, e troque se algum dia vazar (trocar derruba todas as sessões).
JWT_SECRET=

# URL completa do site, sem barra no fim (ex.: https://campelopsi.com.br).
# Usada para montar o link e a imagem de preview quando um post do blog é
# compartilhado no WhatsApp/Facebook/etc. Errada ou ausente quebra esse
# preview sem avisar, por isso o servidor recusa subir em produção sem ela.
SITE_URL=


# ============================================================
# Primeira conta do painel
# ============================================================

# Criada automaticamente na primeira vez que o banco sobe vazio. Depois disso
# estas duas variáveis são ignoradas. Mínimo de 10 caracteres, senão nenhuma
# conta é criada e o painel fica inacessível.
#
# Para trocar a senha depois:
#   docker compose -f docker-compose.prod.yml exec api npm run senha -- <email> "<senha>"
ADMIN_EMAIL=campelo@exemplo.com
ADMIN_SENHA=


# ============================================================
# Domínio e HTTPS (só usado pelo docker-compose.prod.yml)
# ============================================================

# O domínio do site, já apontando para o IP da VPS. O Caddy pede o
# certificado Let's Encrypt sozinho no primeiro boot.
DOMINIO=campelopsi.com.br

# E-mail para os avisos de expiração do certificado.
EMAIL_TLS=campelo@exemplo.com

# Ainda sem domínio e querendo testar pelo IP? Use:
#   DOMINIO=:80
#   COOKIE_SEGURO=false
#
# COOKIE_SEGURO controla a flag `secure` do cookie de sessão, que faz o
# cookie só viajar por HTTPS. Ligada em um site HTTP puro, o navegador
# descarta o cookie em silêncio: o login "falha" sem mensagem de erro
# nenhuma. Em produção com domínio, deixe true.
COOKIE_SEGURO=true

# Quantos proxies existem na frente da API. No docker-compose.prod.yml são
# dois: Caddy e nginx. Valor alto demais deixa qualquer um forjar o cabeçalho
# X-Forwarded-For e escapar do limite de tentativas do login.
TRUST_PROXY=2


# ============================================================
# Caminhos
# ============================================================

# Onde o banco e os uploads ficam dentro do container. O compose mapeia isto
# para o volume campelo-dados, que é o que precisa entrar no backup.
DADOS_DIR=/dados
